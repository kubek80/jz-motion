      "beats": [
        { "title": "Question", "actions": [{ "do": "draw", "target": "heading" }] },
        { "title": "The labs", "actions": [
          { "do": "draw", "target": ["anthropic", "openai", "google", "qwen", "deepseek"], "stagger": 0.9, "duration": 1.6 }
        ] },
        { "title": "Where they are", "actions": [
          { "do": "draw", "target": ["usa", "china"], "stagger": 0.3 },
          { "do": "draw", "target": ["usa-label", "china-label"], "stagger": 0.3, "start": "with", "delay": 0.6 }
