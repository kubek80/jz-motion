                "a-lib",
                "model"
              ],
              "stagger": 0.3
            }
          ]
        },
        {
          "title": "Check",
          "notes": "What comes back is checked against the schema: unknown icons, missing elements, wrong colours…",
          "actions": [
            {
              "do": "draw",
              "target": [
                "a-check",
                "check"
              ],
              "stagger": 0.5
            }
          ]
        },
        {
          "title": "Repair",
          "notes": "…and if anything is wrong, the exact errors go back to the model to fix. That loop is why even small, cheap models produce something that loads.",
          "actions": [
            {
              "do": "draw",
              "target": "repair"
            },
            {
              "do": "flow",
              "target": "repair"
