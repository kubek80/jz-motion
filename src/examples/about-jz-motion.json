        {
          "title": "LLM first",
          "notes": "Under the hood, jz-motion is LLM first. A presentation is not pixels: it's one JSON document.",
          "actions": [
            {
              "do": "draw",
              "target": "h"
            }
          ]
        },
        {
          "title": "Context",
          "notes": "Every request sends the model the format reference, the drawing rules and the whole library: every icon, logo, clipart and 3D model it may use.",
          "actions": [
            {
              "do": "draw",
              "target": [
                "docs",
                "lib"
              ],
              "stagger": 0.4
            },
            {
              "do": "draw",
              "target": [
