          "type": "arrow",
          "from": "weights",
          "to": "mac"
        },
        {
          "id": "to-spark",
          "type": "arrow",
          "from": "weights",
          "to": "spark",
          "curve": 0.12
        },
        {
          "id": "nvidia1",
          "type": "icon",
          "icon": "nvidia",
          "x": 1120,
          "y": 290,
          "size": 80,
          "color": "cyan"
        },
        {
          "id": "apple",
          "type": "icon",
          "icon": "apple",
          "x": 1120,
          "y": 570,
          "size": 80,
          "color": "pink"
        },
        {
          "id": "nvidia2",
          "type": "icon",
          "icon": "nvidia",
          "x": 1120,
          "y": 850,
          "size": 80,
          "color": "green"
        },
        {
          "id": "gpu-note",
          "type": "text",
          "text": "fastest, but VRAM limits model size",
          "x": 1200,
          "y": 290,
          "size": 44,
          "align": "start"
        },
        {
          "id": "mac-note",
          "type": "text",
          "text": "big unified memory, quiet",
          "x": 1200,
          "y": 570,
          "size": 44,
          "align": "start"
        },
        {
          "id": "spark-note",
          "type": "text",
          "text": "128 GB unified memory + CUDA",
          "x": 1200,
          "y": 850,
          "size": 44,
          "align": "start"
        }
      ],
      "beats": [
        {
          "title": "Question",
          "notes": "You have the model weights. The question is: where do they actually run?",
          "actions": [
            {
              "do": "draw",
              "target": "heading"
            },
            {
              "do": "draw",
              "target": "weights"
            }
          ]
        },
        {
          "title": "GPU",
          "notes": "The usual answer is a graphics card. It's the fastest option, but its memory limits how big a model fits.",
          "actions": [
            {
              "do": "draw",
              "target": [
                "to-gpu",
                "gpu",
                "nvidia1",
                "gpu-note"
              ],
              "stagger": 0.7
            }
          ]
        },
        {
          "title": "Mac",
          "notes": "A Mac Studio is the quiet alternative: one big pool of unified memory, so much larger models fit, just slower.",
          "actions": [
            {
              "do": "draw",
              "target": [
                "to-mac",
                "mac",
                "apple",
                "mac-note"
              ],
              "stagger": 0.7
            }
          ]
        },
        {
          "title": "DGX Spark",
          "notes": "And NVIDIA's DGX Spark sits in between: a small desktop box with 128 GB of unified memory and CUDA.",
          "actions": [
            {
              "do": "draw",
              "target": [
                "to-spark",
                "spark",
                "nvidia2",
                "spark-note"
              ],
              "stagger": 0.7
            },
            {
              "do": "flow",
              "target": [
                "to-gpu",
                "to-mac",
                "to-spark"
              ]
            }
          ]
        },
        {
          "title": "Zoom to the Spark",
          "notes": "That combination is the interesting part: the memory of a Mac, with the software everyone already uses on GPUs.",
          "actions": [
            {
              "do": "camera",
              "focus": [
                "spark",
                "spark-note"
              ],
              "padding": 160
            },
            {
              "do": "circle",
              "target": [
                "nvidia2",
                "spark-note"
              ],
              "color": "yellow"
            }
          ]
        },
        {
          "title": "Overview",
          "notes": "So: GPU for speed, Mac for size, Spark if you want both on your desk.",
          "actions": [
            {
              "do": "camera",
              "focus": "all",
              "padding": 70
            }
          ]
        }
      ]
    }
  ]
}
