          "x": 960,
          "y": 110,
          "size": 84,
          "color": "yellow"
        },
        {
          "id": "weights",
          "type": "icon",
          "icon": "file",
          "x": 260,
          "y": 560,
          "size": 150,
          "color": "yellow",
          "label": "model weights"
        },
        {
          "id": "gpu",
          "type": "icon",
          "icon": "gpu",
          "x": 860,
          "y": 300,
          "size": 160,
          "color": "cyan",
          "label": "GPU"
        },
        {
          "id": "mac",
          "type": "icon",
          "icon": "mac-studio",
          "x": 860,
          "y": 580,
          "size": 160,
          "color": "pink",
          "label": "Mac Studio"
        },
        {
          "id": "spark",
          "type": "icon",
          "icon": "dgx-spark",
          "x": 860,
          "y": 860,
          "size": 160,
