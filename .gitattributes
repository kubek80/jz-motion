# Pictures, recordings and sounds in the media library are stored with Git LFS (see docs/media-plan.md):
# the repository keeps small pointers, GitHub keeps the files. The index stays a normal, readable text file.
media/** filter=lfs diff=lfs merge=lfs -text
media/index.json !filter !diff !merge text
# Voice recordings in uploads/ (narration, generated narration, your voice sample) are stored the same way; their
# transcripts stay plain text.
uploads/** filter=lfs diff=lfs merge=lfs -text
uploads/*.transcript.json !filter !diff !merge text
# The channel's pictures (YouTube banner and its backgrounds), the same way.
brand/*.png filter=lfs diff=lfs merge=lfs -text
brand/*.jpg filter=lfs diff=lfs merge=lfs -text
